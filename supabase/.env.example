# Server secrets only. Copy to ignored supabase/.env; never commit real values.
ALLOWED_ORIGINS=https://capt-lando.github.io,http://127.0.0.1:4173
# Selected for the Neeley cloud demo; the actual key stays in server secrets.
COACHING_PROVIDER=openai
COACHING_MODEL=gpt-6-luna
COACHING_API_KEY=
COACHING_RESERVE_MICROUSD=60000
# Optional Anthropic workspace, only if needed by the configured provider.
COACHING_WORKSPACE_ID=

# Exact HTTPS worker URL and hostname; browser-supplied worker URLs are rejected.
BARK_WORKER_URL=
BARK_WORKER_ALLOWED_HOSTS=
BARK_WORKER_TOKEN=
BARK_RESERVE_MICROUSD=75000
# Configure BOTH for a Modal worker protected by requires_proxy_auth=True.
BARK_WORKER_MODAL_KEY=
BARK_WORKER_MODAL_SECRET=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Supabase.
# Never copy the service-role key into the website or a VITE_ variable.
