# LEGACY SERVER ONLY: this file configures the archived server.mjs path.
# The current browser app and GitHub Pages do not read .env files.
# Current speech recognition runs locally in the browser without an HF token.
# Use Connect API in the browser app for coaching; keys stay in tab memory.
# If running the legacy server, keys saved in .env persist on disk. Keep .env private.

# Choose openai, anthropic, google, or huggingface for speech coaching.
ANALYSIS_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Only needed for a Claude key that can access multiple workspaces.
ANTHROPIC_WORKSPACE_ID=

# The legacy server's remote speech transcription uses Hugging Face.
HF_TOKEN=

# Optional model overrides. Otherwise the app chooses the provider's default.
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.8-flash
HF_TRANSCRIPTION_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
HF_ANALYSIS_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Optional dedicated Hugging Face transcription endpoint.
# Must be HTTPS on a *.endpoints.huggingface.cloud host.
# Deploy a compatible speech-recognition model before setting this value.
HF_TRANSCRIPTION_ENDPOINT=
